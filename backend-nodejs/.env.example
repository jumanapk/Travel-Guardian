# Travel Guard Backend Environment Variables
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL or Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/travelguard?schema=public"

# Managed Supabase Configuration (Optional)
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_KEY="your-anon-or-service-key"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"
JWT_EXPIRES_IN="24h"

# CORS Configuration
CLIENT_ORIGIN="http://localhost:3000,http://127.0.0.1:5500"
